NODE_ENV=development
PORT=5000

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/my_database

# Use long random strings in production (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# Comma separated list of allowed origins
CORS_ORIGIN=http://localhost:5173
